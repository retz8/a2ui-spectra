{
  "name": "a2ui-spectra-sample-preview-angular",
  "private": true,
  "version": "0.0.1",
  "description": "The Angular sample catalog app of Spectra for A2UI: the sample catalog's Angular implementation and its preview page, built with the Angular preview adapter.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "wireit",
    "format": "prettier --ignore-path ../../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../../.prettierignore --check ."
  },
  "wireit": {
    "build": {
      "command": "ng build",
      "dependencies": [
        "../../../typescript/preview/angular:build"
      ],
      "files": [
        "src/**/*",
        "angular.json",
        "tsconfig*.json"
      ],
      "output": [
        "dist/"
      ]
    },
    "clean": {
      "command": "rm -rf dist .angular .wireit"
    }
  },
  "dependencies": {
    "@a2ui/angular": "0.13.0",
    "@a2ui/markdown-it": "^0.2.2",
    "@a2ui/web_core": "0.14.0",
    "@angular/common": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "a2ui-spectra-preview-angular": "workspace:^",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/compiler-cli": "^21.2.5",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "prettier": "^3.8.4",
    "typescript": "5.9.3",
    "wireit": "^0.15.0-pre.2"
  }
}
