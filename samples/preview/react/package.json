{
  "name": "a2ui-spectra-sample-preview-react",
  "private": true,
  "version": "0.0.1",
  "description": "The React sample catalog app of Spectra for A2UI: the sample catalog's React implementation and its preview page, built with the React preview adapter.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "wireit",
    "format": "prettier --ignore-path ../../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../../.prettierignore --check ."
  },
  "wireit": {
    "build": {
      "command": "tsc -b && vite build",
      "dependencies": [
        "../../../typescript/preview/react:build"
      ],
      "files": [
        "src/**/*",
        "index.html",
        "tsconfig.json",
        "vite.config.*"
      ],
      "output": [
        "dist/"
      ]
    },
    "clean": {
      "command": "rm -rf dist .wireit"
    }
  },
  "dependencies": {
    "@a2ui/markdown-it": "^0.2.2",
    "@a2ui/react": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "a2ui-spectra-preview-react": "workspace:^",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gts": "^7.0.0",
    "prettier": "^3.8.4",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "wireit": "^0.15.0-pre.2"
  }
}
