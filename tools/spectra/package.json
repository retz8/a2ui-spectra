{
  "name": "a2ui-spectra",
  "private": true,
  "version": "0.1.0",
  "description": "A debugging and observation tool for the developer of an A2UI agent: attach to the running agent, see every turn, check and preview it, record and replay it.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": "./dist/cli.js",
  "scripts": {
    "build": "wireit",
    "build:tsc": "wireit",
    "build:viewer": "wireit",
    "build:binary": "wireit",
    "build:binaries": "wireit",
    "build:packages": "wireit",
    "check:packages": "wireit",
    "pack:libraries": "wireit",
    "check:libraries": "wireit",
    "pack:placeholders": "wireit",
    "set:version": "node scripts/version.mjs set",
    "check:version": "node scripts/version.mjs check",
    "generate:otlp": "wireit",
    "test": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "wireit",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check ."
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:tsc",
        "build:viewer"
      ]
    },
    "build:tsc": {
      "command": "tsc -b --pretty",
      "env": {
        "FORCE_COLOR": "1"
      },
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tsconfig.json"
      ],
      "output": [
        "dist/**",
        "!dist/viewer/**",
        "!dist/a2ui-spectra",
        "!dist/binaries/**",
        "!dist/packages/**",
        "!dist/libraries/**",
        "!dist/placeholders/**"
      ],
      "clean": "if-file-deleted"
    },
    "build:viewer": {
      "command": "node -e \"const fs=require('fs');fs.rmSync('dist/viewer',{recursive:true,force:true});fs.cpSync('../spectra_viewer/dist','dist/viewer',{recursive:true});fs.cpSync('../spectra_basic_preview/dist','dist/viewer/preview',{recursive:true})\"",
      "dependencies": [
        "../spectra_viewer:build",
        "../spectra_basic_preview:build"
      ],
      "files": [],
      "output": [
        "dist/viewer/**"
      ]
    },
    "build:binary": {
      "command": "bun build --compile --minify --sourcemap --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/cli.ts --asset dist/viewer --outfile dist/a2ui-spectra",
      "env": {
        "NODE_ENV": "production"
      },
      "dependencies": [
        "build:viewer"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/a2ui-spectra"
      ]
    },
    "build:binaries": {
      "command": "node scripts/build_binaries.mjs",
      "dependencies": [
        "build:viewer"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tsconfig.json",
        "package.json",
        "scripts/build_binaries.mjs",
        "scripts/bun_runtimes.json"
      ],
      "output": [
        "dist/binaries/**"
      ]
    },
    "build:packages": {
      "command": "node scripts/build_packages.mjs",
      "dependencies": [
        "build:binaries",
        "build:tsc"
      ],
      "files": [
        "scripts/build_packages.mjs",
        "scripts/licences_by_hand/**",
        "scripts/notices.mjs",
        "scripts/notices_by_hand.md",
        "scripts/packages.mjs",
        "wheel/**",
        "README.md",
        "../../LICENSE",
        "src/prices/NOTICE",
        "../../scripts/markdown.mjs",
        "../../docs/**/*.md",
        "../../README.md"
      ],
      "output": [
        "dist/packages/**"
      ]
    },
    "check:packages": {
      "command": "node scripts/check_packages.mjs",
      "dependencies": [
        "build:packages"
      ],
      "files": [
        "scripts/check_packages.mjs",
        "scripts/packages.mjs",
        "scripts/reading.mjs",
        "../../scripts/public/install.sh",
        "../../scripts/markdown.mjs",
        "../../docs/**/*.md",
        "../../README.md",
        "README.md"
      ],
      "output": []
    },
    "pack:libraries": {
      "command": "node scripts/pack_libraries.mjs",
      "dependencies": [
        "../../typescript/preview/core:build",
        "../../typescript/preview/react:build",
        "../../typescript/preview/lit:build",
        "../../typescript/preview/angular:build",
        "../../typescript/instrumentation:build"
      ],
      "files": [
        "scripts/pack_libraries.mjs",
        "scripts/libraries.mjs",
        "scripts/packages.mjs",
        "scripts/version.mjs",
        "src/version.ts",
        "package.json",
        "../../LICENSE",
        "../../typescript/preview/*/package.json",
        "../../typescript/preview/*/README.md",
        "../../typescript/instrumentation/package.json",
        "../../typescript/instrumentation/README.md",
        "../../python/a2ui_spectra_instrumentation/pyproject.toml",
        "../../python/a2ui_spectra_instrumentation/README.md",
        "../../python/a2ui_spectra_instrumentation/src/**/*.py",
        "../../python/a2ui_spectra_instrumentation/src/**/py.typed",
        "../../scripts/markdown.mjs",
        "../../docs/**/*.md",
        "../../README.md"
      ],
      "output": [
        "dist/libraries/**"
      ]
    },
    "check:libraries": {
      "command": "node scripts/check_libraries.mjs",
      "dependencies": [
        "pack:libraries"
      ],
      "files": [
        "scripts/check_libraries.mjs",
        "scripts/libraries.mjs",
        "scripts/packages.mjs",
        "scripts/reading.mjs",
        "../../scripts/markdown.mjs",
        "../../docs/**/*.md",
        "../../README.md",
        "../../typescript/preview/*/README.md",
        "../../typescript/instrumentation/README.md",
        "../../python/a2ui_spectra_instrumentation/README.md"
      ],
      "output": []
    },
    "pack:placeholders": {
      "command": "node scripts/placeholders.mjs",
      "files": [
        "scripts/placeholders.mjs",
        "scripts/release.mjs",
        "scripts/packages.mjs",
        "scripts/libraries.mjs",
        "../../LICENSE"
      ],
      "output": [
        "dist/placeholders/**"
      ]
    },
    "test": {
      "command": "node scripts/run_tests.mjs",
      "dependencies": [
        "build",
        "../../conformance:build",
        "../../conformance/wrapper_driver/typescript:build",
        "../../typescript/preview/react:build",
        "../../typescript/preview/lit:build",
        "../../typescript/preview/angular:build",
        "../spectra_preview_test_pages:build"
      ],
      "env": {
        "SPECTRA_BINARY": {
          "external": true
        },
        "SPECTRA_TEST_PART": {
          "external": true
        }
      },
      "files": [
        "scripts/run_tests.mjs",
        "../../conformance/test_data/turn_record/v0_1/minimal_*.json",
        "../../conformance/test_data/turn_record/v0_1/full_record_*.json",
        "../../conformance/a2a_capture/**",
        "../../conformance/test_data/a2a_capture/**",
        "../../conformance/test_data/model_capture/**",
        "../../conformance/model_capture/**",
        "../../conformance/test_data/tool_capture/**",
        "../../conformance/tool_capture/**",
        "../../conformance/model_replay/**",
        "../../conformance/tool_replay/**",
        "../../specification/turn_record/v0_1/json/*.json",
        "../../samples/preview/catalog.json",
        "../../samples/preview/*/a2ui-spectra.json",
        "../../samples/preview/*/src/**",
        "../../samples/preview/*/index.html",
        "../../samples/preview/*/vite.config.ts",
        "../../samples/preview/angular/angular.json",
        "../../samples/preview/*/package.json",
        "../../conformance/test_data/receiver_capture/**",
        "../../conformance/receiver_capture/**",
        "../../conformance/test_data/wrapper_capture/**",
        "../../conformance/wrapper_capture/**",
        "../../conformance/wrapper_driver/**",
        "../../python/a2ui_spectra_instrumentation/src/**/*.py",
        "../../python/a2ui_spectra_instrumentation/pyproject.toml",
        "../../pyproject.toml",
        "../../uv.lock",
        "../../.python-version",
        "../../scripts/public/**",
        "../../README.md",
        "../../skills/**",
        "../../specification/turn_record/v0_1/docs/turn_record.md",
        "scripts/install_check.mjs",
        "scripts/stand_ins.mjs",
        "scripts/release.mjs",
        "scripts/packages.mjs",
        "scripts/libraries.mjs",
        "../../CHANGELOG.md",
        "../../typescript/preview/core/src/protocol.ts",
        "../../scripts/markdown.mjs"
      ],
      "output": []
    },
    "clean": {
      "command": "rm -rf dist .wireit"
    },
    "generate:otlp": {
      "command": "buf generate",
      "files": [
        "proto/**/*.proto",
        "buf.gen.yaml"
      ],
      "output": [
        "src/receiver/gen/**"
      ]
    }
  },
  "dependencies": {
    "@a2ui/web_core": "0.16.1",
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "ajv": "^8.17.1",
    "bun": "1.4.4",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "js-yaml": "^4.3.0",
    "playwright": "1.58.1",
    "prettier": "^3.8.4",
    "typescript": "6.0.3",
    "wireit": "^0.15.0-pre.2"
  }
}
