{
  "name": "a2ui-spectra-viewer",
  "private": true,
  "version": "0.0.1",
  "description": "The viewer of Spectra for A2UI, served by the a2ui-spectra tool.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "wireit",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check ."
  },
  "wireit": {
    "build": {
      "command": "tsc -b && vite build",
      "files": [
        "src/**/*",
        "!src/**/*.test.ts",
        "!src/testing/**",
        "index.html",
        "tsconfig.json",
        "vite.config.*",
        "components.json"
      ],
      "output": [
        "dist/"
      ]
    },
    "clean": {
      "command": "rm -rf dist .wireit"
    },
    "test": {
      "command": "tsc -p tsconfig.test.json && node --experimental-strip-types --no-warnings=ExperimentalWarning --test --test-reporter spec \"src/**/*.test.ts\"",
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsconfig.json",
        "tsconfig.test.json",
        "../../conformance/test_data/a2a_capture/**"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@a2ui/web_core": "0.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.14.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gts": "^7.0.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "wireit": "^0.15.0-pre.2"
  }
}
