{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/retz8/a2uiverse-apps/blob/main/circleci/circleci-catalog/catalogs/v0.9.1/catalog.json",
  "title": "CircleCI Catalog",
  "description": "The components CircleCI's pipelines UI is built from — layout, panels, text, links, buttons, statuses, lists, fields and logs — and the A2UI basic catalog's functions.",
  "catalogId": "https://github.com/retz8/a2uiverse-apps/blob/main/circleci/circleci-catalog/catalogs/v0.9.1/catalog.json",
  "components": {
    "Stack": {
      "type": "object",
      "description": "Lays its children out in a column or a row. The layout container: use it for every group of components, inside a Panel and between rows.",
      "properties": {
        "component": {
          "const": "Stack"
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The components laid out, in order: a list of ids, or a template over a data-model list."
        },
        "direction": {
          "type": "string",
          "enum": ["vertical", "horizontal"],
          "default": "vertical",
          "description": "The axis the children follow."
        },
        "gap": {
          "type": "string",
          "enum": ["none", "xsmall", "small", "medium", "large"],
          "default": "small",
          "description": "The space between children."
        },
        "align": {
          "type": "string",
          "enum": ["start", "center", "end", "stretch", "baseline"],
          "default": "stretch",
          "description": "Alignment across the axis."
        },
        "justify": {
          "type": "string",
          "enum": ["start", "center", "end", "spaceBetween"],
          "default": "start",
          "description": "Distribution along the axis; 'spaceBetween' pushes the first and last children to the edges."
        },
        "wrap": {
          "type": "boolean",
          "description": "Whether children wrap onto more lines when they do not fit."
        }
      },
      "required": ["component"],
      "unevaluatedProperties": false
    },
    "Panel": {
      "type": "object",
      "description": "A bordered surface grouping one view or one section: the summary of a run, a pipeline with its jobs, a failed step with its log. Holds one child, usually a Stack.",
      "properties": {
        "component": {
          "const": "Panel"
        },
        "child": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "The id of the component inside the panel."
        },
        "padding": {
          "type": "string",
          "enum": ["none", "small", "medium", "large"],
          "default": "medium",
          "description": "The space inside the border."
        },
        "tone": {
          "type": "string",
          "enum": ["default", "muted", "danger"],
          "default": "default",
          "description": "'muted' a quiet filled row, such as a step in a job's step list; 'danger' the red border and pale red fill of a failed step."
        }
      },
      "required": ["component", "child"],
      "unevaluatedProperties": false
    },
    "Heading": {
      "type": "object",
      "description": "A title: 'large' for the view's subject, 'medium' for a section, 'small' for a subsection.",
      "properties": {
        "component": {
          "const": "Heading"
        },
        "text": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The title."
        },
        "size": {
          "type": "string",
          "enum": ["large", "medium", "small"],
          "default": "medium",
          "description": "The title level."
        }
      },
      "required": ["component", "text"],
      "unevaluatedProperties": false
    },
    "Text": {
      "type": "object",
      "description": "A run of text.",
      "properties": {
        "component": {
          "const": "Text"
        },
        "text": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The text."
        },
        "size": {
          "type": "string",
          "enum": ["medium", "small"],
          "default": "medium",
          "description": "The text size."
        },
        "tone": {
          "type": "string",
          "enum": ["default", "muted", "danger"],
          "default": "default",
          "description": "'muted' for secondary facts — times, numbers, authors; 'danger' for an error's own words."
        },
        "weight": {
          "type": "string",
          "enum": ["normal", "medium", "semibold"],
          "default": "normal",
          "description": "The font weight."
        },
        "font": {
          "type": "string",
          "enum": ["sans", "mono"],
          "default": "sans",
          "description": "'mono' for commit hashes, commands and identifiers."
        },
        "truncate": {
          "type": "boolean",
          "description": "Whether the text keeps to one line, cut with an ellipsis."
        }
      },
      "required": ["component", "text"],
      "unevaluatedProperties": false
    },
    "Link": {
      "type": "object",
      "description": "Text in the link color that performs an action when pressed: a branch, a commit, a workflow or job name that opens it.",
      "properties": {
        "component": {
          "const": "Link"
        },
        "text": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The link text."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed when the link is pressed."
        },
        "font": {
          "type": "string",
          "enum": ["sans", "mono"],
          "default": "sans",
          "description": "'mono' for a commit hash."
        }
      },
      "required": ["component", "text", "action"],
      "unevaluatedProperties": false
    },
    "Button": {
      "type": "object",
      "description": "A rounded button that performs an action. 'primary' is the one solid call to action of a view, 'secondary' a grey button, 'ghost' a text-only way out.",
      "properties": {
        "component": {
          "const": "Button"
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The button label: the outcome of pressing it."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed when the button is pressed."
        },
        "variant": {
          "type": "string",
          "enum": ["primary", "secondary", "ghost"],
          "default": "secondary",
          "description": "The button style."
        },
        "size": {
          "type": "string",
          "enum": ["small", "medium"],
          "default": "medium",
          "description": "The button size."
        },
        "disabled": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the button cannot be pressed."
        }
      },
      "required": ["component", "label", "action"],
      "unevaluatedProperties": false
    },
    "StatusBadge": {
      "type": "object",
      "description": "A pipeline's, workflow's or job's status as a rounded pill: a glyph and the word, colored by the word. Use the word the product shows — Success, Failed, Running, On Hold, Queued, Canceled, Not Run, Error, Blocked — or the status value as the data spells it.",
      "properties": {
        "component": {
          "const": "StatusBadge"
        },
        "status": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The status word; it chooses the color and glyph."
        }
      },
      "required": ["component", "status"],
      "unevaluatedProperties": false
    },
    "StatusIcon": {
      "type": "object",
      "description": "A status as a round glyph without its word, for the rows of a list — each job in a workflow, each step in a job. The word is its accessible name.",
      "properties": {
        "component": {
          "const": "StatusIcon"
        },
        "status": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The status word; it chooses the color and glyph."
        },
        "size": {
          "type": "string",
          "enum": ["small", "medium"],
          "default": "medium",
          "description": "The glyph size."
        }
      },
      "required": ["component", "status"],
      "unevaluatedProperties": false
    },
    "List": {
      "type": "object",
      "description": "A list of rows, each a ListItem. 'tree' joins the rows with a connector from the list's left edge, as a pipeline's jobs are drawn under it.",
      "properties": {
        "component": {
          "const": "List"
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The rows: a list of ids, or a template over a data-model list."
        },
        "connector": {
          "type": "string",
          "enum": ["none", "tree"],
          "default": "none",
          "description": "The line joining the rows."
        }
      },
      "required": ["component", "children"],
      "unevaluatedProperties": false
    },
    "ListItem": {
      "type": "object",
      "description": "A row of a List. With an action, the whole row is one pressable target that opens what the row shows. Holds one child, usually a horizontal Stack.",
      "properties": {
        "component": {
          "const": "ListItem"
        },
        "child": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "The id of the row's content."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed when the row is pressed. Omit it for a row that only shows."
        }
      },
      "required": ["component", "child"],
      "unevaluatedProperties": false
    },
    "Field": {
      "type": "object",
      "description": "A labelled fact: a small muted label over its value — Duration, Branch, Commit, Author.",
      "properties": {
        "component": {
          "const": "Field"
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The label."
        },
        "child": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "The id of the value, usually a Text or a Link."
        }
      },
      "required": ["component", "label", "child"],
      "unevaluatedProperties": false
    },
    "Divider": {
      "type": "object",
      "description": "A thin rule separating sections; 'vertical' separates the fields of a row.",
      "properties": {
        "component": {
          "const": "Divider"
        },
        "orientation": {
          "type": "string",
          "enum": ["horizontal", "vertical"],
          "default": "horizontal",
          "description": "The direction of the rule."
        }
      },
      "required": ["component"],
      "unevaluatedProperties": false
    },
    "LogBlock": {
      "type": "object",
      "description": "Output as printed, on a dark panel with line numbers. Its children are LogLine components, one per line, in order.",
      "properties": {
        "component": {
          "const": "LogBlock"
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The lines: a list of LogLine ids, or a template over a data-model list of lines."
        }
      },
      "required": ["component", "children"],
      "unevaluatedProperties": false
    },
    "LogLine": {
      "type": "object",
      "description": "One line of output inside a LogBlock, exactly as printed.",
      "properties": {
        "component": {
          "const": "LogLine"
        },
        "text": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The line."
        }
      },
      "required": ["component", "text"],
      "unevaluatedProperties": false
    }
  },
  "functions": {
    "required": {
      "type": "object",
      "description": "Checks that the value is not null, undefined, or empty.",
      "properties": {
        "call": {
          "const": "required"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "description": "The value to check."
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "regex": {
      "type": "object",
      "description": "Checks that the value matches a regular expression string.",
      "properties": {
        "call": {
          "const": "regex"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            },
            "pattern": {
              "type": "string",
              "description": "The regex pattern to match against."
            }
          },
          "required": ["value", "pattern"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "length": {
      "type": "object",
      "description": "Checks string length constraints.",
      "properties": {
        "call": {
          "const": "length"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "description": "The minimum allowed length."
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "description": "The maximum allowed length."
            }
          },
          "required": ["value"],
          "anyOf": [
            {
              "required": ["min"]
            },
            {
              "required": ["max"]
            }
          ],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "numeric": {
      "type": "object",
      "description": "Checks numeric range constraints.",
      "properties": {
        "call": {
          "const": "numeric"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber"
            },
            "min": {
              "type": "number",
              "description": "The minimum allowed value."
            },
            "max": {
              "type": "number",
              "description": "The maximum allowed value."
            }
          },
          "required": ["value"],
          "anyOf": [
            {
              "required": ["min"]
            },
            {
              "required": ["max"]
            }
          ],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "email": {
      "type": "object",
      "description": "Checks that the value is a valid email address.",
      "properties": {
        "call": {
          "const": "email"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatString": {
      "type": "object",
      "description": "Performs string interpolation of data model values and other functions in the catalog functions list and returns the resulting string. The value string can contain interpolated expressions in the `${expression}` format. Supported expression types include: JSON Pointer paths to the data model (e.g., `${/absolute/path}` or `${relative/path}`), and client-side function calls (e.g., `${now()}`). Function arguments must be named (e.g., `${formatDate(value:${/currentDate}, format:'MM-dd')}`). To include a literal `${` sequence, escape it as `\\${`.",
      "properties": {
        "call": {
          "const": "formatString"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatNumber": {
      "type": "object",
      "description": "Formats a number with the specified grouping and decimal precision.",
      "properties": {
        "call": {
          "const": "formatNumber"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "The number to format."
            },
            "decimals": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
            },
            "grouping": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
              "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatCurrency": {
      "type": "object",
      "description": "Formats a number as a currency string.",
      "properties": {
        "call": {
          "const": "formatCurrency"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "The monetary amount."
            },
            "currency": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "The ISO 4217 currency code (e.g., 'USD', 'EUR')."
            },
            "decimals": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
            },
            "grouping": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
              "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
            }
          },
          "required": ["currency", "value"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatDate": {
      "type": "object",
      "description": "Formats a timestamp into a string using a pattern.",
      "properties": {
        "call": {
          "const": "formatDate"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue",
              "description": "The date to format."
            },
            "format": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "A Unicode TR35 date pattern string.\n\nToken Reference:\n- Year: 'yy' (26), 'yyyy' (2026)\n- Month: 'M' (1), 'MM' (01), 'MMM' (Jan), 'MMMM' (January)\n- Day: 'd' (1), 'dd' (01), 'E' (Tue), 'EEEE' (Tuesday)\n- Hour (12h): 'h' (1-12), 'hh' (01-12) - requires 'a' for AM/PM\n- Hour (24h): 'H' (0-23), 'HH' (00-23) - Military Time\n- Minute: 'mm' (00-59)\n- Second: 'ss' (00-59)\n- Period: 'a' (AM/PM)\n\nExamples:\n- 'MMM dd, yyyy' -> 'Jan 16, 2026'\n- 'HH:mm' -> '14:30' (Military)\n- 'h:mm a' -> '2:30 PM'\n- 'EEEE, d MMMM' -> 'Friday, 16 January'"
            }
          },
          "required": ["format", "value"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "pluralize": {
      "type": "object",
      "description": "Returns a localized string based on the Common Locale Data Repository (CLDR) plural category of the count (zero, one, two, few, many, other). Requires an 'other' fallback. For English, just use 'one' and 'other'.",
      "properties": {
        "call": {
          "const": "pluralize"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "The numeric value used to determine the plural category."
            },
            "zero": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "String for the 'zero' category (e.g., 0 items)."
            },
            "one": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "String for the 'one' category (e.g., 1 item)."
            },
            "two": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "String for the 'two' category (used in Arabic, Welsh, etc.)."
            },
            "few": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "String for the 'few' category (e.g., small groups in Slavic languages)."
            },
            "many": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "String for the 'many' category (e.g., large groups in various languages)."
            },
            "other": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "The default/fallback string (used for general plural cases)."
            }
          },
          "required": ["value", "other"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "openUrl": {
      "type": "object",
      "description": "Opens the specified URL in a browser or handler. This function has no return value.",
      "properties": {
        "call": {
          "const": "openUrl"
        },
        "args": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "The URL to open."
            }
          },
          "required": ["url"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "void"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "and": {
      "type": "object",
      "description": "Performs a logical AND operation on a list of boolean values.",
      "properties": {
        "call": {
          "const": "and"
        },
        "args": {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "description": "The list of boolean values to evaluate.",
              "items": {
                "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean"
              },
              "minItems": 2
            }
          },
