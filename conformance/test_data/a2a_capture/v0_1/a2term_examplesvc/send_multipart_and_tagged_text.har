            "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"message\":{\"messageId\":\"01a16c28-6d52-7f00-aa94-6b8df7c5f811\",\"contextId\":\"01a16c28-6d52-7d91-9a70-9a1528f76e34\",\"parts\":[{\"text\":\"Here is a multi-part response with text and interactive A2UI:\",\"mediaType\":\"text/plain\"},{\"data\":[{\"updateComponents\":{\"components\":[{\"child\":\"multipart_col\",\"component\":\"Card\",\"id\":\"root\"},{\"children\":[\"mp_title\",\"mp_desc\",\"mp_div_1\",\"mp_row_badges\",\"mp_div_2\",\"mp_body\",\"mp_div_3\",\"mp_row_actions\"],\"component\":\"Column\",\"id\":\"multipart_col\"},{\"component\":\"Text\",\"id\":\"mp_title\",\"text\":\"🔀 Multi-Part A2A Message\",\"variant\":\"h1\"},{\"component\":\"Text\",\"id\":\"mp_desc\",\"text\":\"Demonstrating an A2A message with both text/plain and application/a2ui+json parts.\",\"variant\":\"caption\"},{\"component\":\"Divider\",\"id\":\"mp_div_1\"},{\"children\":[\"mp_badge_parts\",\"mp_badge_mime\",\"mp_badge_status\"],\"component\":\"Row\",\"id\":\"mp_row_badges\"},{\"component\":\"Text\",\"id\":\"mp_badge_parts\",\"text\":\"[📦 Multi-Part A2A]\",\"variant\":\"body\"},{\"component\":\"Text\",\"id\":\"mp_badge_mime\",\"text\":\"[🏷️ application/a2ui+json]\",\"variant\":\"body\"},{\"component\":\"Text\",\"id\":\"mp_badge_status\",\"text\":\"[🟢 Connected]\",\"variant\":\"body\"},{\"component\":\"Divider\",\"id\":\"mp_div_2\"},{\"component\":\"Text\",\"id\":\"mp_body\",\"text\":\"This surface was delivered via an A2A DataPart carrying declarative A2UI components alongside a separate text part in the same response.\",\"variant\":\"body\"},{\"component\":\"Divider\",\"id\":\"mp_div_3\"},{\"children\":[\"btn_mp_action\",\"btn_mp_return\"],\"component\":\"Row\",\"id\":\"mp_row_actions\"},{\"action\":{\"event\":{\"context\":{\"source\":\"multipart_card\"},\"name\":\"multipart_test_action\"}},\"child\":\"txt_mp_action\",\"component\":\"Button\",\"id\":\"btn_mp_action\"},{\"component\":\"Text\",\"id\":\"txt_mp_action\",\"t