            "text": "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"message\":{\"messageId\":\"01a16c28-6d56-7514-be9c-48cb5dfe8e5c\",\"contextId\":\"01a16c28-6d52-7d91-9a70-9a1528f76e34\",\"parts\":[{\"text\":\"Here is the Button Gallery:\\n\\n\\u003ca2ui-json\\u003e\\n{\\n  \\\"updateComponents\\\": {\\n    \\\"components\\\": [\\n      {\\n        \\\"child\\\": \\\"btn_col\\\",\\n        \\\"component\\\": \\\"Card\\\",\\n        \\\"id\\\": \\\"root\\\"\\n      },\\n      {\\n        \\\"children\\\": [\\n          \\\"btn_title\\\",\\n          \\\"btn_desc\\\",\\n          \\\"div_btn\\\",\\n          \\\"row_actions\\\"\\n        ],\\n        \\\"component\\\": \\\"Column\\\",\\n        \\\"id\\\": \\\"btn_col\\\"\\n      },\\n      {\\n        \\\"component\\\": \\\"Text\\\",\\n        \\\"id\\\": \\\"btn_title\\\",\\n        \\\"text\\\": \\\"🔘 Button Gallery\\\",\\n        \\\"variant\\\": \\\"h1\\\"\\n      },\\n      {\\n        \\\"component\\\": \\\"Text\\\",\\n        \\\"id\\\": \\\"btn_desc\\\",\\n        \\\"text\\\": \\\"Select any button to trigger an A2UI action event back to the agent.\\\",\\n        \\\"variant\\\": \\\"body\\\"\\n      },\\n      {\\n        \\\"component\\\": \\\"Divider\\\",\\n        \\\"id\\\": \\\"div_btn\\\"\\n      },\\n      {\\n        \\\"children\\\": [\\n          \\\"btn_approve\\\",\\n          \\\"btn_reject\\\",\\n          \\\"btn_cancel\\\"\\n        ],\\n        \\\"component\\\": \\\"Row\\\",\\n        \\\"id\\\": \\\"row_actions\\\"\\n      },\\n      {\\n        \\\"action\\\": {\\n          \\\"event\\\": {\\n            \\\"context\\\": {\\n              \\\"decision\\\": \\\"approved\\\",\\n              \\\"item_id\\\": \\\"item-994\\\"\\n            },\\n            \\\"name\\\": \\\"approve_request\\\"\\n          }\\n        },\\n        \\\"child\\\": \\\"txt_approve\\\",\\n        \\\"component\\\": \\\"Button\\\",\\n        \\\"id\\\": \\\"btn_approve\\\"\\n      },\\n      {\\n        \\\"component\\\": \\\"Text\\\",\\n        \\\"id\\\": \\\"txt_approve\\\",\\n        \\\"text\\\": \\\"✅ Approve\\\"\\n      },\\n      {\\n        \\\"action\\\": {\\n          \\\"event\\\": {\\n            \\\"context\\\": {\\n              \\\"decision\\\": \\\"rejected\\\",\\n              \\\"item_id\\\": \\\"item-994\\\"\\n            },\\n            \\\"name\\\": \\\"reject_request\\\"\\n          }\\n        },\\n        \\\"child\\\": \\\"txt_reject\\\",\\n        \\\"component\\\": \\\"Button\\\",\\n        \\\"id\\\": \\\"btn_reject\\\"\\n      },\\n      {\\n        \\\"component\\\": \\\"Text\\\",\\n        \\\"id\\\": \\\"txt_reject\\\",\\n        \\\"text\\\": \\\"❌ Reject\\\"\\n      },\\n      {\\n        \\\"action\\\": {\\n          \\\"event\\\": {\\n            \\\"context\\\": {\\n              \\\"decision\\\": \\\"cancel\\\"\\n            },\\n            \\\"name\\\": \\\"cancel_action\\\"\\n          }\\n        },\\n        \\\"child\\\": \\\"txt_cancel\\\",\\n        \\\"component\\\": \\\"Button\\\",\\n        \\\"id\\\": \\\"btn_cancel\\\"\\n      },\\n      {\\n        \\\"component\\\": \\\"Text\\\",\\n        \\\"id\\\": \\\"txt_cancel\\\",\\n        \\\"text\\\": \\\"⏹ Cancel\\\"\\n      }\\n    ],\\n    \\\"surfaceId\\\": \\\"button-surface\\\"\\n  },\\n  \\\"version\\\": \\\"v0.9\\\"\\n}\\n\\u003c/a2ui-json\\u003e\"}],\"role\":\"ROLE_AGENT\"}}}\n"
