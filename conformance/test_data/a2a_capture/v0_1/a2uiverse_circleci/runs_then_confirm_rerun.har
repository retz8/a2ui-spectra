          "content": {
            "size": 2974,
            "mimeType": "application/json",
            "text": "{\"capabilities\":{\"extensions\":[{\"description\":\"Provides agent driven UI using the A2UI JSON format.\",\"params\":{\"supportedCatalogIds\":[\"https://github.com/retz8/a2uiverse-apps/blob/main/circleci/circleci-catalog/catalogs/v0.9.1/catalog.json\"]},\"uri\":\"https://a2ui.org/a2a-extension/a2ui/v0.9.1\"}],\"streaming\":true},\"defaultInputModes\":[\"text\",\"text/plain\"],\"defaultOutputModes\":[\"text\",\"text/plain\"],\"description\":\"Shows your CircleCI pipelines: recent runs by branch and commit with their outcome, each run's workflows and jobs, and why a job failed from its logs. Reruns or cancels a workflow once you confirm.\",\"documentationUrl\":\"https://github.com/retz8/a2uiverse-apps/blob/main/circleci/agent/README.md\",\"name\":\"CircleCI\",\"preferredTransport\":\"JSONRPC\",\"protocolVersion\":\"0.3.0\",\"provider\":{\"organization\":\"CircleCI\",\"url\":\"https://app.circleci.com\"},\"security\":[{\"signIn\":[\"pipelines.read\"]}],\"securitySchemes\":{\"signIn\":{\"flows\":{\"authorizationCode\":{\"authorizationUrl\":\"http://127.0.0.1:11014/oauth/authorize\",\"refreshUrl\":\"http://127.0.0.1:11014/oauth/token\",\"scopes\":{\"pipelines.read\":\"See your projects, pipelines and their runs\",\"pipelines.write\":\"Rerun and cancel your workflows\"},\"tokenUrl\":\"http://127.0.0.1:11014/oauth/token\"}},\"oauth2MetadataUrl\":\"http://127.0.0.1:11014/.well-known/oauth-authorization-server\",\"type\":\"oauth2\"}},\"skills\":[{\"description\":\"Shows recent pipeline runs across your projects: which branch and commit each ran on, whether it passed, failed or is still running, and its workflows.\",\"examples\":[\"How are my builds doing?\",\"Is CI green on main?\",\"Did my last push pass CI?\",\"Which branches are failing?\",\"Anything broken in CI I should look at?\",\"Show me the recent pipeline runs\"],\"id\":\"pipeline_status\",\"name\":\"Pipeline status\",\"tags\":[\"a2ui\",\"circleci\",\"ci\",\"pipelines\",\"builds\"]},{\"description\":\"Opens one pipeline run and shows its workflows and each workflow's jobs, with their status and how long they took.\",\"examples\":[\"Open the latest run on main\",\"Which job failed?\",\"Show me the jobs in that workflow\",\"What ran for my last commit?\"],\"id\":\"run_detail\",\"name\":\"A run's workflows and jobs\",\"tags\":[\"a2ui\",\"circleci\",\"ci\",\"workflow\",\"jobs\"]},{\"description\":\"Finds the step that failed in a job and shows what it printed: the failing command, its exit code, and the end of its log.\",\"examples\":[\"Why did the build fail?\",\"Show me the logs of the failing job\",\"What broke in the lint job?\",\"What error did the tests hit?\"],\"id\":\"failure_diagnosis\",\"name\":\"Why a job failed\",\"tags\":[\"a2ui\",\"circleci\",\"ci\",\"logs\",\"failure\"]},{\"description\":\"Reruns a workflow — every job, or only the failed ones — or cancels one that's still running, once you confirm.\",\"examples\":[\"Rerun the failed workflow\",\"Rerun only the failed jobs\",\"Retry CI on main\",\"Cancel the running build\"],\"id\":\"rerun_cancel\",\"name\":\"Rerunning and canceling\",\"tags\":[\"a2ui\",\"circleci\",\"ci\",\"rerun\",\"cancel\"]}],\"url\":\"http://127.0.0.1:11014\",\"version\":\"0.1.0\"}"
          },
