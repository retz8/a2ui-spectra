{
  "name": "a2ui-spectra-conformance",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "build:tsc": "wireit",
    "test": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "wireit",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check ."
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:tsc"
      ]
    },
    "build:tsc": {
      "command": "tsc -b --pretty",
      "env": {
        "FORCE_COLOR": "1"
      },
      "files": [
        "tests/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "node --test --enable-source-maps --test-reporter spec \"dist/tests/**/*.test.js\"",
      "dependencies": [
        "build"
      ],
      "files": [
        "conformance_schema.json",
        "turn_record/**",
        "test_data/turn_record/**",
        "../specification/turn_record/**/json/*.json"
      ],
      "output": []
    },
    "clean": {
      "command": "rm -rf dist .wireit"
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "ajv": "^8.17.1",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "js-yaml": "^4.3.0",
    "prettier": "^3.8.4",
    "typescript": "5.9.3",
    "wireit": "^0.15.0-pre.2"
  }
}
