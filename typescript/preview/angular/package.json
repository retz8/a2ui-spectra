{
  "name": "a2ui-spectra-preview-angular",
  "private": true,
  "version": "0.1.0",
  "description": "The Angular preview adapter of Spectra for A2UI: one standalone component for a catalog's preview page, on upstream's Angular renderer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retz8/a2ui-spectra.git",
    "directory": "typescript/preview/angular"
  },
  "bugs": {
    "url": "https://github.com/retz8/a2ui-spectra/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types/a2ui-spectra-preview-angular.d.ts",
      "default": "./dist/fesm2022/a2ui-spectra-preview-angular.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "wireit",
    "format": "prettier --ignore-path ../../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../../.prettierignore --check ."
  },
  "wireit": {
    "build": {
      "command": "ng build lib",
      "dependencies": [
        "../core:build"
      ],
      "files": [
        "src/**/*",
        "angular.json",
        "ng-package.json",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "clean": {
      "command": "rm -rf dist .wireit"
    }
  },
  "dependencies": {
    "a2ui-spectra-preview": "workspace:^",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@a2ui/angular": "0.16.0",
    "@a2ui/web_core": "0.16.1",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "ng-packagr": "^22.2.3",
    "prettier": "^3.8.4",
    "rxjs": "^7.8.2",
    "typescript": "6.0.3",
    "wireit": "^0.15.0-pre.2"
  },
  "peerDependencies": {
    "@a2ui/angular": "^0.16.0",
    "@a2ui/web_core": "^0.16.1",
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3"
  }
}
