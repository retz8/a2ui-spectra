{
  "name": "a2ui-spectra-preview-angular",
  "private": true,
  "version": "0.0.1",
  "description": "The Angular preview adapter of Spectra for A2UI: one standalone component for a catalog's preview page, on upstream's Angular renderer.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/types/a2ui-spectra-preview-angular.d.ts",
      "default": "./dist/fesm2022/a2ui-spectra-preview-angular.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "wireit",
    "format": "prettier --ignore-path ../../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../../.prettierignore --check ."
  },
  "wireit": {
    "build": {
      "command": "ng build lib",
      "dependencies": [
        "../core:build"
      ],
      "files": [
        "src/**/*",
        "angular.json",
        "ng-package.json",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "clean": {
      "command": "rm -rf dist .wireit"
    }
  },
  "dependencies": {
    "a2ui-spectra-preview": "workspace:^",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@a2ui/angular": "0.13.0",
    "@a2ui/web_core": "0.14.0",
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/compiler-cli": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.4",
    "rxjs": "^7.8.2",
    "typescript": "5.9.3",
    "wireit": "^0.15.0-pre.2"
  },
  "peerDependencies": {
    "@a2ui/angular": "^0.13.0",
    "@a2ui/web_core": "^0.14.0",
    "@angular/common": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/platform-browser": "^21.2.5"
  }
}
