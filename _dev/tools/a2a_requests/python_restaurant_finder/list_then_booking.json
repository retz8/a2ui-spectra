        "Accept": "text/event-stream",
        "X-A2A-Extensions": "https://a2ui.org/a2a-extension/a2ui/v0.9"
      },
      "body": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "message/stream",
        "params": {
          "message": {
            "kind": "message",
            "messageId": "restaurant-finder-user-2",
            "role": "user",
